# ===== LLM (OpenRouter — один ключ на все модели) =====
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ярусы моделей (id брать с https://openrouter.ai/models)
# CHEAP — черновики, классификация, извлечение данных (~85% вызовов)
# STRONG — ревью кода, проверка сообщений клиентам, сложные решения
MODEL_CHEAP=google/gemini-2.5-flash
MODEL_STRONG=anthropic/claude-sonnet-4.5
# Модель оркестратора; пусто = MODEL_CHEAP. Если роутинг тупит — поставь сильную.
MODEL_ORCHESTRATOR=

# ===== Твой WhatsApp =====
# Только цифры с кодом страны, например 79991234567.
# Команды ассистенту принимаются ТОЛЬКО с этого номера.
OWNER_PHONE=

# ===== Green API (https://green-api.com, облачный WhatsApp-шлюз) =====
# Инстанс ассистента (бесплатный тариф Developer). idInstance и apiTokenInstance — из консоли Green API.
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# Рассыльный инстанс (второй номер; можно позже — пока пусто, рассылка идёт с ассистента)
GREEN_API_OUTREACH_ID_INSTANCE=
GREEN_API_OUTREACH_TOKEN=
# Токен вебхука (поле webhookUrlToken в консоли Green API) — придумай свой
GREEN_API_WEBHOOK_TOKEN=

# ===== Postgres на поде InstaPods =====
# Креды после: instapods services add <под> -s postgresql -w
#              instapods services creds <под> -s postgresql
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# ===== Поиск =====
# Serper: https://serper.dev (бесплатных 2500 запросов хватит надолго)
SERPER_API_KEY=
# Или Tavily: https://tavily.com (если задан Serper — используется он)
TAVILY_API_KEY=
# 2GIS API (компании+телефоны по нише и городу): https://dev.2gis.com
TWOGIS_API_KEY=

# ===== Google Sheets =====
# JSON сервисного аккаунта лежит в secrets/google-service-account.json
# Кому расшаривать созданные таблицы (твой gmail):
GOOGLE_SHARE_EMAIL=
SHEETS_PUBLIC_LINK=true

# ===== Рассылка (лимиты против бана) =====
OUTREACH_DAILY_LIMIT=20
OUTREACH_BATCH_PER_TICK=2
OUTREACH_MIN_DELAY_S=45
OUTREACH_MAX_DELAY_S=180

# ===== Веб-админка =====
# Открой https://<под>.instapods.app/admin (логин admin, пароль отсюда).
# Пусто = админка выключена. Придумай ДЛИННЫЙ пароль — админка управляет всей системой.
ADMIN_PASSWORD=

# ===== Встроенный планировщик =====
SCHEDULER_ENABLED=true
OUTREACH_TICK_MINUTES=15
MONITORING_TICK_HOURS=6
